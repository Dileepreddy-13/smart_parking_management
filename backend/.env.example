# ---- Required -------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/smartparking"
JWT_SECRET="change-me-to-a-long-random-string"

# ---- Server ---------------------------------------------------------------
PORT=5000
NODE_ENV=development
FRONTEND_URL="http://localhost:5173"
JWT_EXPIRES_IN="1d"
# Timezone used for operating hours, "today" statistics and e-mail dates
APP_TIMEZONE="Asia/Kolkata"

# ---- Pricing & policy -----------------------------------------------------
TAX_PERCENT=18
# Minutes a PENDING (unpaid) reservation holds its slot before it expires
PAYMENT_HOLD_MINUTES=10
# Cancel at least this many minutes before start for a full refund
FREE_CANCEL_MINUTES=60
# Refund percentage when cancelling later than that (but before start)
LATE_CANCEL_REFUND_PERCENT=50

# ---- Razorpay TEST MODE (optional) ----------------------------------------
# Leave empty to use the built-in simulated payment gateway.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# ---- SMTP (optional) ------------------------------------------------------
# Leave empty and e-mails are logged to the console instead of sent.
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Smart Parking <no-reply@smartparking.local>"
